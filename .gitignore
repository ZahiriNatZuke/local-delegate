# Datos de uso (NUNCA versionar): el log de delegaciones
usage.jsonl
*.jsonl

# Python
__pycache__/
*.py[oc]
build/
dist/
# Salida de scripts/build_site.py (GitHub Pages). El comentario va en su propia linea:
# .gitignore NO admite comentarios al final de un patron, se los traga como parte del nombre.
_site/
wheels/
*.egg-info/

# Entornos virtuales
.venv/
.env

# Artefactos de demo / scratch
_demo*
scratch_*
scratch/
dashboard.js
.playwright-mcp/

# Config local de Claude Code (lleva rutas absolutas / puede tener secretos)
.claude/

# Secretos y credenciales (por si acaso; solo se versionan *.example)
*.secret
secrets.*

# Local Codex configuration
.codex/
AGENTS.md

# IDEs de JetBrains
.idea/

# Módulo de hooks del mod: lo genera scripts/build_mod.py (y el hook de hatch_build.py en cada
# build de la rueda) desde mod/*.js. No se versiona.
src/local_delegate/resources/claude-plugin/local-delegate/register.js
