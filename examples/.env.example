# local-delegate — variables de entorno (copia a .env y ajusta). NO subas tu .env real.

# --- Endpoint OpenAI-compatible ---
LOCAL_DELEGATE_BASE_URL=http://127.0.0.1:9292/v1
# LOCAL_DELEGATE_API_KEY=          # solo si tu endpoint exige un token
# LOCAL_DELEGATE_TIMEOUT=180

# --- Catálogo de modelos (ids según tu backend) ---
# LOCAL_DELEGATE_MODEL_MECHANICAL=gemma3-4b
# LOCAL_DELEGATE_MODEL_LONG=gemma4-26b-a4b
# LOCAL_DELEGATE_MODEL_CODE=qwen36-35b-a3b
# LOCAL_DELEGATE_MODEL_FAST=qwen35-2b
# LOCAL_DELEGATE_MODEL_VISION=gemma4-12b

# --- Respaldo entre modelos (encendido por defecto) ---
# LOCAL_DELEGATE_FALLBACK=1
# LOCAL_DELEGATE_FALLBACK_MAX_HOPS=2
# LOCAL_DELEGATE_FALLBACK_CODE=residente,long      # roles o ids separados por comas; none = sin respaldo
# LOCAL_DELEGATE_FALLBACK_LONG=residente,code
# LOCAL_DELEGATE_FALLBACK_MECHANICAL=long

# --- Enfriamiento por modelo (encendido por defecto) ---
# LOCAL_DELEGATE_COOLDOWN=1
# LOCAL_DELEGATE_COOLDOWN_FAILURES=3
# LOCAL_DELEGATE_COOLDOWN_S=120
# LOCAL_DELEGATE_COOLDOWN_MAX_S=900

# --- Chunking de documentos largos (local_translate / local_delegate) ---
# LOCAL_DELEGATE_CHUNK_CHARS=3500        # tamaño de trozo
# LOCAL_DELEGATE_CHUNK_MAX_TOKENS=2048   # techo de salida por trozo
# LOCAL_DELEGATE_CHUNK_MIN_CHARS=400     # trozo mínimo: por debajo no se vuelve a partir

# --- Web de métricas ---
# LOCAL_DELEGATE_WEB=1
# LOCAL_DELEGATE_WEB_PORT=9393

# --- Log de uso (default: dir de datos de usuario) ---
# LOCAL_DELEGATE_LOG=/ruta/a/usage.jsonl

# --- Auto-arranque de llama-swap (opt-in) ---
# LOCAL_DELEGATE_AUTOSTART=0
# LLAMASWAP_EXE=llama-swap
# LLAMASWAP_CONFIG=/ruta/a/llama-swap/config.yaml
# LLAMASWAP_LISTEN=127.0.0.1:9292
# LLAMASWAP_WATCH_CONFIG=0
