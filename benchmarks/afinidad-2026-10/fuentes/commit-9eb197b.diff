+    assert "cierre" in result.detail
+
+
+def test_codex_indentado_sin_marcadores_sigue_siendo_de_otro(tmp_path):
+    """Sin el de apertura no es nuestra, con sangría o sin ella: `warn`, y `update` no la pisa."""
