+    result: list[dict] = []
+
+    def _collect_and_prune(data: dict) -> None:
+        stale = []
+        for key, v in data.items():
+            age = now - v.get("started_at", 0)
+            pid = v.get("pid")
+            if age > _INFLIGHT_STALE_S or (pid is not None and not _pid_alive(pid)):
+                stale.append(key)
