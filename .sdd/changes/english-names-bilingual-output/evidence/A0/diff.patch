+    assert "LOCAL_DELEGATE_MAX_CHARS_FAST" in result.detail
+    assert "settings.json" in result.detail
+    assert "OTRA" not in result.detail
+
+
+def test_retired_variables_come_from_the_single_registry(recargar_config):
