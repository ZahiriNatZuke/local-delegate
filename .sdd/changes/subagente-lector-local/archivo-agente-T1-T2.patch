+def test_el_wheel_lleva_el_agente():
+    """Hatchling empaqueta `src/local_delegate` entero; esto comprueba que el `.md` entra de verdad.
+
+    Instalar con `uv tool` desde el árbol no lo prueba: lee del árbol, no del wheel.
+    """
+    import subprocess
+    import sys
+    import tempfile
+    import zipfile
+
+    import pytest
+
+    raiz = Path(__file__).parents[1]
+    with tempfile.TemporaryDirectory() as out:
+        r = subprocess.run(
+            ["uv", "build", "--wheel", "--out-dir", out, str(raiz)],
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        if r.returncode != 0:
+            pytest.skip(f"uv build no disponible: {r.stderr[-200:]}")
+        (whl,) = Path(out).glob("*.whl")
+        nombres = zipfile.ZipFile(whl).namelist()
+    assert f"local_delegate/resources/agents/{agents.OWN_AGENT_NAME}.md" in nombres, sys.platform
