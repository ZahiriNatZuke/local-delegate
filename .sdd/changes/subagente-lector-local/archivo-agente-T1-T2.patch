+    "local_extract",
+    "local_translate",
+    "local_explain_code",
+    "local_lint_summary",
+    "local_commit_msg",
+    "local_describe_image",
+)
+
+
+def own_agent_text(resource: Path) -> str | None:
+    """El texto del agente propio tal como va empaquetado; None si no se puede leer.
+
+    La ruta se recibe por la misma razón que en `tool_catalog`: sin importar `install`.
+    """
+    try:
+        return resource.read_text(encoding="utf-8")
+    except OSError:
+        return None
+
+
+def is_own_agent(text: str) -> bool:
+    """True si el fichero lleva nuestro marcador: solo entonces se actualiza o se borra."""
+    return OWN_MARKER in text
