+# Presupuesto de arranque (REQ-001b). Constantes MEDIDAS el 2026-09-22 en transcripts reales
+# (research.md, «De dónde sale el coste fijo»): primer turno del subagente con `omitClaudeMd` y una
+# sola tool (`local_summarize`, 1 235 caracteres de esquema) = 2 274 tokens; añadir los otros 10
+# esquemas (11 651 caracteres) sumó 4 210 tokens. De ahí la proporción de tokens por carácter de
+# esquema. El prompt del probador medía ~70 caracteres; lo que el nuestro pase de eso también cuenta.
+_BASE_UNA_TOOL = 2274
+_CHARS_ESQUEMA_BASE = 1235
+_TOKENS_POR_CHAR_ESQUEMA = 4210 / 11651
+_CHARS_PROMPT_PROBADOR = 70
+_PRESUPUESTO = 6000
+
+
+def _chars_esquemas() -> dict[str, int]:
+    import asyncio
+    import json
+
+    from local_delegate import server
+
+    tools = asyncio.run(server.mcp.list_tools())
+    return {
+        t.name: len(
+            json.dumps(
+                {"name": t.name, "description": t.description, "input_schema": t.input_schema},
+                ensure_ascii=False,
+            )
+        )
+        for t in tools
+    }
+
+
+def _estimar_arranque(tools: list[str], chars_prompt: int, esquemas: dict[str, int]) -> float:
+    chars = sum(esquemas[t] for t in tools)
+    return (
+        _BASE_UNA_TOOL
+        + (chars - _CHARS_ESQUEMA_BASE) * _TOKENS_POR_CHAR_ESQUEMA
+        + max(0, chars_prompt - _CHARS_PROMPT_PROBADOR) * _TOKENS_POR_CHAR_ESQUEMA
+    )
+
+
+def test_el_arranque_del_agente_cabe_en_el_presupuesto():
+    esquemas = _chars_esquemas()
+    cuerpo = (agents.own_agent_text(AGENTE_PROPIO) or "").split("---", 2)[2]
+    estimado = _estimar_arranque(list(agents.OWN_AGENT_TOOLS), len(cuerpo), esquemas)
+    assert estimado <= _PRESUPUESTO, f"arranque estimado {estimado:.0f} tokens"
+
+    # Control positivo: con las 11 tools el mismo cálculo se pasa. Si no, el test no discrimina.
+    todas = _estimar_arranque(list(esquemas), len(cuerpo), esquemas)
+    assert todas > _PRESUPUESTO, f"con todas: {todas:.0f}"
+
