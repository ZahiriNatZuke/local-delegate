+def test_warn_del_agente_propio_lo_repone_sin_tocar_los_agentes_del_usuario(tmp_path):
+    """Reparar lo nuestro no autoriza a tocar lo suyo: el componente es `agente`, no `agents`."""
+    from local_delegate import agents
+
+    home = make_home(tmp_path, complete=False)
+    d = home / ".claude" / "agents"
+    d.mkdir(parents=True, exist_ok=True)
+    # Un agente del usuario que `--agents` SÍ actualizaría (declara nuestra tool y tiene sección).
+    suyo = d / "suyo.md"
+    suyo.write_text(
+        f"---\nname: suyo\ntools: {agents.ANCHOR}\n---\n\n## Delegación a modelos locales\n\nx\n",
+        encoding="utf-8",
+    )
+    propio = d / f"{agents.OWN_AGENT_NAME}.md"
+    propio.write_text(f"{agents.OWN_MARKER} viejo -->\n", encoding="utf-8")
+    antes = suyo.read_bytes()
+
+    results = results_from(**{"scaffold.own_agent": checks.WARN})
+    actions, _notes = update.plan_repairs(results, opts_for(home))
+    assert [a for a in actions if a.target == propio], "el agente propio no se repone"
+    install.apply(actions, dry_run=False, out=lambda *_a: None)
+    assert suyo.read_bytes() == antes
+    assert agents.is_own_agent(propio.read_text(encoding="utf-8"))
+    assert "viejo" not in propio.read_text(encoding="utf-8")
