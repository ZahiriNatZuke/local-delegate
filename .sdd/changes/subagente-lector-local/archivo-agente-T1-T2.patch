+def own_agent_paths(claude: Path) -> tuple[Path, Path]:
+    """(recurso empaquetado, destino en ~/.claude/agents/) del subagente propio."""
+    from . import agents as agents_mod
+
+    nombre = f"{agents_mod.OWN_AGENT_NAME}.md"
+    return resources_dir() / "agents" / nombre, claude / "agents" / nombre
+
+
+def own_agent_state(claude: Path) -> tuple[str, str | None]:
+    """Estado del subagente propio: (estado, texto empaquetado).
+
+    Estados: ``falta``, ``al-dia``, ``desactualizado``, ``ajeno`` (un fichero con ese nombre sin
+    nuestro marcador: lo escribió el usuario y no se toca) y ``sin-recurso`` (el paquete no trae
+    el fichero; no debería pasar, y si pasa no se escribe nada).
+    """
+    from . import agents as agents_mod
+
+    src, dst = own_agent_paths(claude)
+    nuevo = agents_mod.own_agent_text(src)
+    if nuevo is None:
+        return "sin-recurso", None
+    if not dst.is_file():
+        return "falta", nuevo
+    actual = _read_text(dst)
+    # Ilegible cuenta como ajeno: si no se puede leer, no se puede saber si es nuestro, y la
+    # degradación segura de una escritura es no escribir.
+    if not agents_mod.is_own_agent(actual):
+        return "ajeno", nuevo
+    if actual.replace("\r\n", "\n") == nuevo.replace("\r\n", "\n"):
+        return "al-dia", nuevo
+    return "desactualizado", nuevo
+
+
+def _own_agent_install_actions(claude: Path) -> list[Action]:
+    estado, nuevo = own_agent_state(claude)
+    _src, dst = own_agent_paths(claude)
+    if estado in ("al-dia", "sin-recurso") or nuevo is None:
+        return []
+    if estado == "ajeno":
+        # Se dice en el plan en vez de callarlo: quien pidió `--agents` espera ver el agente, y
+        # tiene que saber por qué no aparece.
+        return [
+            Action(
+                "agents",
+                dst,
+                "NO se toca: existe un fichero con ese nombre sin el marcador de local-delegate",
+                lambda: "sin cambios (fichero del usuario)",
+            )
+        ]
+
+    def _run(path=dst, text=nuevo) -> str:
+        _write_text(path, text)  # `.bak` si ya existía y conserva su terminador de línea
+        return "escrito"
+
+    detalle = "crea" if estado == "falta" else "actualiza"
+    return [Action("agents", dst, f"{detalle} el subagente propio", _run, literal=nuevo)]
+
+
+def _own_agent_uninstall_actions(claude: Path) -> list[Action]:
+    estado, _nuevo = own_agent_state(claude)
+    _src, dst = own_agent_paths(claude)
+    if estado == "ajeno":
+        return [
+            Action(
+                "remove",
+                dst,
+                "NO se borra: no lleva el marcador de local-delegate",
+                lambda: "sin cambios (fichero del usuario)",
+            )
+        ]
+    if estado not in ("al-dia", "desactualizado"):
+        return []
+
+    def _run(path=dst) -> str:
+        path.unlink(missing_ok=True)
+        return "eliminado"
+
+    return [Action("remove", dst, "borra el subagente propio", _run)]
+
+
